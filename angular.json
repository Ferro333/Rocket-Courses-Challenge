{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
      "rocket-courses": {
        "projectType": "application",
        "root": "",
        "sourceRoot": "src",
        "prefix": "app",
        "architect": {
          "build": {
            "builder": "@angular-devkit/build-angular:application",
            "options": {
              "browser": "src/main.ts",
              "index": "src/index.html",
              "polyfills": ["zone.js"],
              "tsConfig": "tsconfig.app.json",
              "assets": [],
              "styles": [
                "src/styles.css"
              ]
            },
            "configurations": {
              "production": {
                "optimization": true,
                "outputHashing": "all",
                "sourceMap": false
              },
              "development": {
                "optimization": false,
                "sourceMap": true
              }
            },
            "defaultConfiguration": "production"
          },
          "serve": {
            "builder": "@angular-devkit/build-angular:dev-server",
            "configurations": {
              "production": {
                "buildTarget": "rocket-courses:build:production"
              },
              "development": {
                "buildTarget": "rocket-courses:build:development"
              }
            },
            "defaultConfiguration": "development"
          }
        }
      }
    },
    "cli": {
      "analytics": false
    }
  }